#!/usr/bin/env bash
# Refuses a push whose new commits (messages, authors, files), tag messages or ref names carry
# private data (scripts/privacy-guard.mjs). Installed by scripts/install-githooks.sh.
set -u
guard="$(cd "$(dirname "$0")/.." && pwd -P)/scripts/privacy-guard.mjs"
nonzero() { case "$1" in *[!0]*) return 0 ;; *) return 1 ;; esac; }
status=0
refs=''
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] && nonzero "$local_sha" || continue # a deletion pushes no content
  refs="$refs$local_ref $remote_ref
"
  if [ "$(git cat-file -t "$local_sha" 2>/dev/null)" = tag ]; then
    git cat-file tag "$local_sha" | node "$guard" --stdin 'tag object' || status=1
  fi
  if nonzero "${remote_sha:-0}" && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    node "$guard" --range "$remote_sha..$local_sha" </dev/null || status=1
  elif git rev-parse --verify --quiet 'origin/main^{commit}' >/dev/null; then
    node "$guard" --range "origin/main..$local_sha" </dev/null || status=1
  else
    node "$guard" --history "$local_sha" </dev/null || status=1
  fi
done
if [ -n "$refs" ]; then
  printf '%s' "$refs" | node "$guard" --stdin 'pushed ref names' || status=1
fi
[ "$status" -eq 0 ] && exit 0
if [ "${DEVDASH_ALLOW:-}" = 1 ]; then
  echo "privacy-guard: BYPASSED by DEVDASH_ALLOW=1. Pushing anyway; CI ignores it and has no denylist." >&2
  exit 0
fi
echo "privacy-guard: push refused. Rewrite the commits, tag or branch name that carry a hit. For a false positive only: DEVDASH_ALLOW=1 git push … CI scans each PR again, but only after this push has published it, and without the denylist." >&2
exit 1
